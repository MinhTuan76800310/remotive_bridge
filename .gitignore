# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.hypothesis/
.ruff_cache/
.mypy_cache/
dist/
build/
*.egg-info/

# Operator configuration. mapping.example.yaml is documentation and IS tracked;
# a real mapping names internal signals and may point at a token file.
mapping.yaml
*.local.yaml

# Secrets. Nothing in this repo should ever need one, but an accidental .env is
# the classic way credentials reach a remote.
.env
*.jwt
*.pem
*.key

# Generated topology output. `remotive topology generate` recreates build/ from
# instances/, and the generated copy embeds the absolute paths of whichever
# machine ran it.
vss-vcar/build/

# The CPD package is a separate deliverable that ships with its own container
# images. Only its docs and overlay are present here, so its SHA256SUMS does not
# verify — publishing that partial copy would ship something broken. Get the
# real package from its own release.
cpd-core-only-1.0.0/

# Editor / OS noise
.DS_Store
*.swp
.idea/
.vscode/
