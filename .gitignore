# Secrets. Nothing in this repo should ever need one, but an accidental .env is
# the classic way credentials reach a remote.
.env
*.jwt
*.pem
*.key

# Generated topology output. `make gen` recreates build/ from instances/, and
# the checked-in copy embeds the absolute paths of whichever machine ran it.
vss-vcar/build/

